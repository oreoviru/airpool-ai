# =========================================================================
# AirPool AI - Environment Configuration
# =========================================================================

# -------------------------------------------------------------------------
# CLOUDINARY CONFIGURATION (Mandatory Hackathon Sponsor Requirement)
# Sign up at https://cloudinary.com/ (free tier)
# -------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Database Persistence)
# Create a project at https://supabase.com/
# Run the migration file in /src/lib/supabase/schema.sql in the SQL Editor
# -------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NOTE: If any of these environment variables are not yet provided,
# AirPool AI automatically operates with the built-in demo fallback adapter,
# ensuring zero crashes during live judge evaluations!
